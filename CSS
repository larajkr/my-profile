body {
  background-color: #f4f4f4;
  font-family: Arial, sans-serif;
  color: rgb(50, 50, 50);
  font-size: 16px;
}

h1, h2 {
  color: #333;
}

.container {
  width: 700px;
  margin: 40px auto;
}

.card {
  background: white;
  padding: 30px;
  margin: 20px 0;
  border-radius: 5px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  text-align: center;
}

.img-circle {
  width: 120px;
  border-radius: 50%;
}

.btn {
  display: inline-block;
  background-color: #6c63ff;
  color: white;
  padding: 10px 15px;
  border-radius: 4px;
  text-decoration: none;
}

.btn:hover {
  background-color: #5a52d4;
}

.list-inline {
  list-style: none;
  padding-left: 0;
}

.list-inline li {
  display: inline;
  margin: 0 10px;
}